// Cloudflare Pages config. KriffMaps is a static SPA: Pages serves dist
// and, because there is no 404.html, falls back to index.html for client-side
// routes such as /table. No server code runs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kriffmaps",
  "compatibility_date": "2026-11-01",
  "pages_build_output_dir": "./dist",
}
