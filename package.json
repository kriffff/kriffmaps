{
  "name": "kriffmaps",
  "description": "Lightweight two-screen battlemap display and initiative tracker for tabletop RPGs (Draw Steel and D&D).",
  "license": "MIT",
  "author": "kriffff",
  "repository": {
    "type": "git",
    "url": "https://github.com/kriffff/kriffmaps.git"
  },
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-tesseract-assets.mjs && vite dev",
    "build": "node scripts/copy-tesseract-assets.mjs && vite build && node scripts/generate-sw.mjs",
    "build:dev": "node scripts/copy-tesseract-assets.mjs && vite build --mode development && node scripts/generate-sw.mjs",
    "preview": "bun run build && wrangler pages dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "bun run build && playwright test",
    "format": "prettier --write .",
    "deploy": "bun run build && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/router-plugin": "1.168.23",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6",
    "eslint": "10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^4.11.0",
    "globals": "17",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "wrangler": "4"
  }
}
